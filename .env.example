# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afm_db
DB_USER=gulshan
DB_PASS=your_db_password

# Database TLS / SSL (Set DB_SSL=true for Cloud MySQL like TiDB / Aiven / RDS)
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=true
DB_SSL_CIPHER=

# Session Driver: 'native' (default for InfinityFree/VPS) or 'database' (required for Vercel Serverless)
SESSION_DRIVER=native
SESSION_LIFETIME=86400

# Application Environment & Security
APP_ENV=production
APP_SECRET=generate_a_random_32_char_secret_key
GOOGLE_SITE_VERIFICATION=

# HTTPS & Reverse Proxy Settings
# TRUST_PROXY_HEADERS=false   # Set to 'true' only if behind a verified reverse proxy (e.g., OpenResty, Cloudflare) that strips client headers
# FORCE_HTTPS=false           # Set to 'true' to force all scheme detection to HTTPS
# SESSION_COOKIE_SECURE=      # Explicitly force session cookie Secure flag (true/false). Defaults to request HTTPS state.
# APP_URL=                    # Optional canonical base URL (e.g. https://afm2.infinityfreeapp.com)
