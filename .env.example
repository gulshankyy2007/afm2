# ==============================================================================
# AFM#2 — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# SECURITY NOTICE:
# - Never commit real credentials, database passwords, or secret keys to Git.
# - In production (APP_ENV=production), a valid, high-entropy APP_SECRET of at
#   least 32 characters (64 hex characters) is strictly required. The application
#   will fail closed if default placeholders or empty values are detected.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Secrets
# ------------------------------------------------------------------------------
# Set to 'production' for live hosting or 'development' for local workstation.
APP_ENV=development

# Application Secret Key (Used for CSRF signature validation and token hashing)
# Required in production: Must be at least 32 characters (256-bit entropy).
# Generate a strong production secret in terminal via PHP:
#   php -r 'echo bin2hex(random_bytes(32)) . PHP_EOL;'
APP_SECRET=generate_a_random_32_character_hex_secret_before_production

# ------------------------------------------------------------------------------
# 2. Database Connection Settings (REQUIRED)
# ------------------------------------------------------------------------------
# Database host (e.g. 127.0.0.1 for local, or sqlXXX.infinityfree.com for hosting)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=afm_db
DB_USER=your_db_username
DB_PASS=your_db_password

# Database TLS / SSL (Set DB_SSL=true only if using managed cloud MySQL like RDS/Aiven)
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=true
DB_SSL_CIPHER=

# ------------------------------------------------------------------------------
# 3. Session Configuration
# ------------------------------------------------------------------------------
# Session Driver: 'native' (default for InfinityFree / Apache / VPS) or 'database'
SESSION_DRIVER=native
SESSION_LIFETIME=86400

# ------------------------------------------------------------------------------
# 4. HTTPS, Cookies & Reverse-Proxy Trust (DELIBERATE CONFIGURATION)
# ------------------------------------------------------------------------------
# TRUST_PROXY_HEADERS: Set to 'true' ONLY if behind an authentic, verified reverse
# proxy (e.g. Cloudflare, AWS ALB, Nginx) that strips incoming client forwarding
# headers. When false, X-Forwarded-* headers are strictly untrusted.
TRUST_PROXY_HEADERS=false

# FORCE_HTTPS: Set to 'true' to force canonical URL generation to https://.
# Note: Per RFC 6797 §7.2, HSTS headers will NOT be emitted over plain HTTP even
# if FORCE_HTTPS=true unless verified cryptographic TLS transport is established.
FORCE_HTTPS=false

# SESSION_COOKIE_SECURE: Explicitly override the session cookie Secure flag.
# - Leave blank to automatically match request HTTPS state.
# - Set 'true' to guarantee session cookies are transmitted only over TLS.
# - Set 'false' for local plain-HTTP development.
# SESSION_COOKIE_SECURE=

# APP_URL: Canonical application URL without trailing slash (e.g. https://afm2.infinityfreeapp.com)
# APP_URL=

# ------------------------------------------------------------------------------
# 5. Optional Integrations
# ------------------------------------------------------------------------------
# Google Search Console site verification meta tag content (optional)
GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------------------------
# 6. Modular Multi-Method Authentication (OPTIONAL)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI must be: https://your-domain.com/auth_callback.php?provider=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://afm2.infinityfreeapp.com/auth_callback.php?provider=google

# WebAuthn / FIDO2 Passkeys Relying Party Configuration (Optional overrides)
# Defaults to incoming HTTP Host and origin if left unconfigured.
# WEBAUTHN_RP_ID=afm2.infinityfreeapp.com
# WEBAUTHN_ORIGIN=https://afm2.infinityfreeapp.com
