# ==============================================================================
# AFM#2 — Git Ignore Policy (Security & Data Leak Prevention)
# ==============================================================================

# Environment files containing live or local secrets
.env
.env.*
!.env.example

# Credentials, generated password notes, and private keys
config/*readme*.txt
config/rotated_credentials_readme.txt
*credential*
*password*
*.key
*.pem

# Database dumps, raw SQL scripts, and schema migrations with live data
*.sql
AFM2_import.sql
deployment/*.sql
deployment/afm2_full_backup.sql

# Production data CSVs and review spreadsheets
*.csv
AFM2_songs_import.csv
AFM2_duplicate_review.csv
My YouTube Library.csv
My YouTube Music Library.csv

# Compressed deployment and archive bundles
*.tar.gz
*.zip
*.bak
afm2-deploy.tar.gz
afm2-infinityfree.zip
deployment/*.zip

# Backup directories
backups/

# Scratchpad, temporary debugging artifacts, and logs
scratch/
artifacts/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.prproj
*.aep
*.log
bin/*.log
gitleaks*.json

# Video and multimedia showcase production workspaces
AFM2_CINEMATIC_SHOWCASE_2026/
AFM2_Showcase_Production/

# Heavy binary document formats (source Markdown and HTML tracked in docs/)
*.docx
*.pdf
/AFM2_Participants_Guide_2026.docx
/AFM2_Participants_Guide_2026.pdf
/AFM2_Participants_Guide_2026.html
/AFM2_Participants_Guide_2026.md

# Standalone external manual deployment web builds
AFM2_Participants_Guide_Web/

# Security audit and remediation forensic reports (persisted in backups/artifacts)
/AFM2_SECURITY_AUDIT_PHASE_1.md
/AFM2_SECURITY_REMEDIATION_PHASE_2.md
/AFM2_SECURITY_CHANGELOG.md
/AFM2_SECURITY_TEST_REPORT.md

# IDE, editor, and operating system metadata
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode and caches
__pycache__/
*.pyc
*.pyo

# Vercel CLI deployment metadata
.vercel/

# Node / vendor dependencies if any
node_modules/
vendor/
