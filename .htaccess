# ==============================================================================
# AFM#2 - Production Apache Web Server Routing & Hardened Security
# Compatible with Apache 2.2 and 2.4+ (InfinityFree / cPanel / Shared & VPS)
# ==============================================================================

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Google Search Console & Search Engine Ownership Verification Files
    # Served directly from root without rewrite, authentication, or redirection
    RewriteCond %{REQUEST_URI} ^/google[a-f0-9]+\.html$ [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Block direct access to hidden files and version control directories
    RewriteRule (^|/)\.(?!well-known) - [F]

    # 3. Prevent infinite recursion if already prefixed with /public/
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # 4. If a legitimate public asset exists directly in root (e.g. favicon.ico, robots.txt), serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 5. Route root request directly to public/index.php
    RewriteRule ^$ public/index.php [L]

    # 6. Route all other application routes to public/ directory
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Hardened Security: Deny direct web access to sensitive environment, database, source archives, and config files
<FilesMatch "^\.env|config\.php|db\.php|\.sql$|\.sh$|\.json$|\.md$|\.tar\.gz$|\.zip$|\.bak$|\.csv$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicitly permit Web App Manifest for PWA installation
<Files "manifest.json">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>
<Files "manifest.webmanifest">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# Ensure correct MIME type for PWA manifests
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/manifest+json .json
</IfModule>

# Security Headers (Defense in depth)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://i.ytimg.com https://img.youtube.com https://yt3.ggpht.com https://images.unsplash.com https://coverartarchive.org https://archive.org https://*.archive.org; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"

    # Versioned CSS & JavaScript assets (cache busters ?v=... ensure freshness upon release)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Service Worker and PWA Manifests must never be cached long-term to ensure immediate updates
    <Files "sw.js">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>
    <FilesMatch "^(manifest\.json|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    # Static images and webfonts
    <FilesMatch "\.(ico|png|jpe?g|svg|webp|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Dynamic application scripts and HTML must never be stored in shared/public caches
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ==============================================================================
# Performance Optimizations: Gzip Compression & Browser Caching
# ==============================================================================

# 1. Gzip Compression for text-based resources (mod_deflate)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon

    # Exclude already-compressed binary media
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|mp3|mp4|zip|gz)$ no-gzip dont-vary

    # Ensure proxy caches vary based on compression support
    Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# 2. Browser Caching Policy (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"

    # Static versioned assets (1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # Static image assets (1 month)
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
</IfModule>

